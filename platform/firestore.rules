rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ═══════════════════════════════════════════════════════════════
    // Helper functions
    // ═══════════════════════════════════════════════════════════════
    
    // Returns true if the authenticated user's UID matches the resource owner
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // Returns true if the authenticated user exists (signed in)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Returns true if this is a create operation
    function isCreate() {
      return request.resource == resource;
    }
    
    // Returns true if this is an update operation
    function isUpdate() {
      return request.resource != resource;
    }

    // Returns true when a billing summary document contains only fields that
    // are safe for the account owner to read from a browser client.
    function isSafeBillingSummary(data) {
      return data.keys().hasOnly([
        'tier',
        'status',
        'statusReason',
        'hardBlocked',
        'blockReason',
        'quota',
        'currentPeriod',
        'updatedAt'
      ])
      && (!('quota' in data) || data.quota.keys().hasOnly([
        'unit',
        'limit',
        'used',
        'remaining',
        'windowId',
        'windowStart',
        'windowEnd',
        'resetsAt'
      ]))
      && (!('currentPeriod' in data) || data.currentPeriod.keys().hasOnly([
        'startedAt',
        'endsAt',
        'cancelAtPeriodEnd'
      ]));
    }

    // ═══════════════════════════════════════════════════════════════
    // Account documents: accounts/{uid}
    // ═══════════════════════════════════════════════════════════════
    // - Only the authenticated owner can read/write their account doc
    // - Account creation is idempotent (create-or-read pattern)
    
    match /accounts/{uid} {
      // Read: owner only
      allow read: if isAuthenticated() && isOwner(uid);
      
      // Create: allow if the requesting user is creating their own account
      // This supports the idempotent bootstrap pattern
      allow create: if isAuthenticated() && isOwner(uid);
      
      // Update: owner only, but cannot change authUserId
      allow update: if isAuthenticated() && isOwner(uid)
                    && (!('authUserId' in request.resource.data)
                        || request.resource.data.authUserId == uid);
    }

    // ═══════════════════════════════════════════════════════════════
    // Settings subcollection: accounts/{uid}/settings/{docId}
    // ═══════════════════════════════════════════════════════════════
    // - Uses 'current' as the canonical document ID for settings snapshot
    // - Only the account owner can read/write their settings
    
    match /accounts/{uid}/settings/{docId} {
      // Read: owner only
      allow read: if isAuthenticated() && isOwner(uid);
      
      // Write: owner only (create, update, delete)
      allow write: if isAuthenticated() && isOwner(uid);
    }

    // ═══════════════════════════════════════════════════════════════
    // Browser-safe account summaries: accounts/{uid}/summaries/billing
    // ═══════════════════════════════════════════════════════════════
    // - Only sanitized owner-safe billing fields may be exposed here
    // - Server/Admin code owns all writes and bypasses security rules

    match /accounts/{uid}/summaries/billing {
      allow read: if isAuthenticated() && isOwner(uid) && isSafeBillingSummary(resource.data);
      allow write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // Server-owned billing, quota, usage, and moderation documents
    // ═══════════════════════════════════════════════════════════════
    // - These paths may contain Stripe IDs, raw usage/costs, operator notes,
    //   provider metadata, and quota ledger state
    // - Browser clients must never read or write them; server/Admin code bypasses
    //   security rules for internal projection and ledger updates

    match /accounts/{uid}/billing/internal {
      allow read, write: if false;
    }

    match /accounts/{uid}/billing/events/{eventId} {
      allow read, write: if false;
    }

    match /accounts/{uid}/billing/{document=**} {
      allow read, write: if false;
    }

    match /accounts/{uid}/quota/windows/{windowId} {
      allow read, write: if false;
    }

    match /accounts/{uid}/quota/{document=**} {
      allow read, write: if false;
    }

    match /accounts/{uid}/usage/events/{eventId} {
      allow read, write: if false;
    }

    match /accounts/{uid}/usage/{document=**} {
      allow read, write: if false;
    }

    match /accounts/{uid}/moderation/current {
      allow read, write: if false;
    }

    match /accounts/{uid}/moderation/{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // Deployments subcollection: accounts/{uid}/deployments/{deploymentId}
    // ═══════════════════════════════════════════════════════════════
    // - Only the account owner can read/create their deployment records
    // - Updates allowed for status sync (owner only)
    // - Deletion not supported in v1 (deployments are append-only feed)
    
    match /accounts/{uid}/deployments/{deploymentId} {
      // Read: owner only - allows feed queries and individual record reads
      allow read: if isAuthenticated() && isOwner(uid);
      
      // Create: owner only - allows deployment creation
      allow create: if isAuthenticated() && isOwner(uid);
      
      // Update: owner only - allows status sync and orchestration metadata updates
      // Cannot change ownership or the account scope
      allow update: if isAuthenticated() && isOwner(uid)
                    && (!('accountScope' in request.resource.data)
                        || request.resource.data.accountScope == uid);
      
      // Delete: not allowed in v1 - deployments are durable historical records
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // Stripe webhook idempotency ledger: stripeWebhookEvents/{stripeEventId}
    // ═══════════════════════════════════════════════════════════════
    // - Contains provider event IDs and raw processing state
    // - Server/Admin code owns all reads and writes

    match /stripeWebhookEvents/{stripeEventId} {
      allow read, write: if false;
    }
  }
}
