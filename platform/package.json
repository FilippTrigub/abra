{
  "name": "platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:unit": "vitest run",
    "test:emulator": "FIREBASE_EMULATOR_HOST=localhost:9000 sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; firebase emulators:exec --only auth,firestore \"pnpm test:unit $*\"' --",
    "emulators:status": "firebase emulators:exec --only auth,firestore 'echo Emulators running'",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@azure/identity": "^4.8.0",
    "@kubernetes/client-node": "^1.0.0",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^25.0.0",
    "playwright": "^1.48.0",
    "tailwindcss": "^4",
    "vitest": "^2.1.0"
  }
}
