# ---------------------------------------------------------------------------
# Firebase platform configuration
# ---------------------------------------------------------------------------

# Browser-facing config — safe to expose in client bundles (NEXT_PUBLIC_*)
# Get these from your Firebase project: Project Settings → General → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Server-only service account credentials
# Get these from Firebase project: Project Settings → Service accounts → Generate new private key
# ⚠️ NEVER prefix these with NEXT_PUBLIC_ — they must remain server-only
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: Firebase emulator host for local development
# Set to "localhost:9000" when running the Firebase emulator suite
FIREBASE_EMULATOR_HOST=

# Optional: Session cookie TTL in milliseconds (default: 432000000 = 5 days)
# Must be between 300000 (5 min) and 1209600000 (14 days)
FIREBASE_SESSION_EXPIRY_MS=

# AKS deployment runtime image
# Runtime backend selector. AKS is the default when unset.
# Set to "mock" only for explicit local/test simulation.
ORCHESTRATION_BACKEND=

# Runtime image precedence: payload.image > AKS_RUNTIME_IMAGE > ABRA_RUNTIME_IMAGE (compatibility fallback)
# Use the Hermes Abra runtime image, e.g. abraacr914f.azurecr.io/abra:<tag>.
AKS_RUNTIME_IMAGE=

# AKS runtime namespace and PVC retention policy
AKS_RUNTIME_NAMESPACE=
AKS_PVC_RETENTION_DAYS=

# Azure Workload Identity / federated auth for AKS
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_FEDERATED_TOKEN_FILE=

# Azure Foundry key injected into the Abra runtime Secret for model access.
AZURE_FOUNDRY_API_KEY=

# ---------------------------------------------------------------------------
# Billing and managed-runtime quota admission
# ---------------------------------------------------------------------------

# Server-only Stripe Billing configuration. Never prefix these with NEXT_PUBLIC_.
# Growth is the only paid tier: 30 EUR/month for 100 managed inbound messages
# per fixed UTC week. The Stripe price amount lives in Stripe; this app reads
# only the recurring Price ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_GROWTH_PRICE_ID=

# Platform endpoint and secret used to derive per-account/per-deployment runtime
# credentials for managed Hermes pods before message processing.
ABRA_MANAGED_ADMISSION_URL=
ABRA_MANAGED_RUNTIME_CREDENTIAL_SECRET=

# Optional bearer secret for GET /api/internal/billing/reconciliation.
ABRA_BILLING_RECONCILIATION_SECRET=

# Optional: base64-encoded kubeconfig content for hosted runtimes (for example Vercel)
# Used when no filesystem kubeconfig path is available. When set, the app materializes
# it to a temporary file and points KUBECONFIG at that file before loading the AKS client.
KUBECONFIG_B64=

# Legacy compatibility fallback for older AKS configs
ABRA_RUNTIME_IMAGE=

# Optional: bypass all auth checks in local development only.
# Only honored when NODE_ENV=development.
DEV_AUTH_BYPASS=false
