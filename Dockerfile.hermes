FROM nousresearch/hermes-agent:latest

USER root

# jq: JSON processing in Abra skills
# curl: AKS readiness/liveness probes
# golang-go: Go runtime (needed to build/run Go-based tools such as songsee)
# manim system deps: cairo, pango, ffmpeg for animation rendering
# LaTeX: pdflatex + recommended fonts/packages for Manim LaTeX scenes
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl jq \
        golang-go \
        libcairo2-dev libpango1.0-dev ffmpeg \
        texlive-latex-base texlive-fonts-recommended texlive-latex-extra \
        texlive-science dvisvgm dvipng \
    && rm -rf /var/lib/apt/lists/* \
    && /opt/hermes/.venv/bin/python3 -m ensurepip --upgrade \
    && /opt/hermes/.venv/bin/python3 -m pip install --no-cache-dir manim

# Bake Abra profile data into the image so the AKS init container can hydrate
# the Hermes profile at pod startup without any network calls.
# The init container (same image, command-overridden) copies these to the PVC.
COPY SOUL.md      /opt/abra/SOUL.md
COPY WORKFLOW.md  /opt/abra/WORKFLOW.md
COPY AGENTS.md    /opt/abra/AGENTS.md
COPY skills/      /opt/abra/skills/

USER hermes
