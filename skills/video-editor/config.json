{
  "input_dir": "./input",
  "output_dir": "./output",
  "model": "Wan-AI/Wan2.1-VACE-1.3B-diffusers",
  "prompt": "high quality, cinematic, natural movement",
  "negative_prompt": "worst quality, blurry, distorted",
  "mask": "background",
  "strength": 0.85,
  "num_inference_steps": 30,
  "guidance_scale": 5.0,
  "batch_size": 8,
  "max_proc_dim": 384,
  "provider": "local",
  "runpod_api_key_env": "RUNPOD_API_KEY",
  "runpod_endpoint_id_env": "RUNPOD_ENDPOINT_ID_VIDEO_EDITOR",
  "runpod_gpu_type": "NVIDIA A100 80GB",
  "remote_timeout_seconds": 600
}
