{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claw-parade.local/schemas/remotion-video/render-spec.v1.schema.json",
  "title": "Remotion Video Render Spec v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "render_spec_version",
    "composition",
    "title",
    "duration_seconds",
    "fps",
    "width",
    "height",
    "background",
    "brand",
    "scenes",
    "assets",
    "output"
  ],
  "properties": {
    "render_spec_version": {
      "type": "string",
      "const": "1.0"
    },
    "composition": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 16
    },
    "height": {
      "type": "integer",
      "minimum": 16
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["solid"]
        },
        "color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primary_color",
        "secondary_color",
        "accent_color",
        "text_color",
        "font_family"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primary_color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "secondary_color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "text_color": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        },
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "logo_path": {
          "type": "string",
          "minLength": 1
        },
        "cta_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "duration_seconds"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["title", "content", "cta"]
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "headline": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "background_color": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "video_filename", "thumbnail_filename", "overwrite"],
      "properties": {
        "basename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "video_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.mp4$"
        },
        "thumbnail_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.(png|jpg|jpeg)$"
        },
        "overwrite": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["image", "video", "audio", "font"]
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
