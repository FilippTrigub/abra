naming_prefix = "abra"
location      = "northeurope"

tags = {
  environment = "prod"
  managed_by  = "terraform"
  project     = "abra"
}

postgres_admin_user     = "abrapgadmin"
postgres_admin_password = "replace-with-strong-password"

kubernetes_version  = "1.34.7"
aks_sku_tier        = "Free"
aks_node_vm_size    = "Standard_D4s_v5"
aks_default_node_count = 1
aks_min_node_count     = 1
aks_max_node_count     = 3
aks_max_pods           = 30
aks_os_disk_size_gb    = 128
aks_service_cidr       = "10.0.0.0/16"
aks_dns_service_ip     = "10.0.0.10"

api_server_authorized_ip_ranges = [
  "203.0.113.10/32",
]
